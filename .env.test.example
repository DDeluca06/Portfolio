# Test Environment Configuration
# Copy this file to .env.test and customize for your environment

# Test Configuration
TEST_API_URL=http://localhost:3001
TEST_STATS_API_KEY=test-api-key-for-testing-only
TEST_BASE_URL=http://localhost:4173
TEST_INFLUX_ENABLED=false

# Docker Configuration
DOCKER_HOST=tcp://localhost:2375

# Rate Limiting (increased for tests)
RATE_LIMIT_READS_PER_MINUTE=1000
RATE_LIMIT_WRITES_PER_MINUTE=100

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4173
ENABLE_HSTS=false

# Skip certain tests
SKIP_RATE_LIMIT_TEST=true
