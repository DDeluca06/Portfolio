# Security Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# API Authentication
# Generate a new secure key with: openssl rand -hex 32
# IMPORTANT: Never use the example value below in production!
STATS_API_KEY=your-secure-api-key-here-generate-with-openssl-rand-hex-32

# Stats API Configuration
SERVER_NAME=Homelab Server

# CORS Configuration
ALLOWED_ORIGINS=https://your-portfolio-domain.com,https://www.your-portfolio-domain.com

# Rate Limiting (requests per minute)
RATE_LIMIT_READS_PER_MINUTE=100
RATE_LIMIT_WRITES_PER_MINUTE=20

# Security Headers
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# InfluxDB Configuration (for metrics storage)
# Required: InfluxDB API token for the application to write metrics
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token-here
INFLUX_ORG=homelab
INFLUX_BUCKET=metrics

# Docker Compose Environment
# Required for Docker deployment: Admin password and token for InfluxDB initialization
INFLUX_ADMIN_PASSWORD=change-this-secure-password
INFLUX_ADMIN_TOKEN=your-influx-admin-token-min-32-chars-recommended
